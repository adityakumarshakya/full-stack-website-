# ============================================
# Orinnovative Backend - Environment Variables
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
# ============================================

# Server
NODE_ENV=development
PORT=5000

# The public URL where the frontend is served (used for sitemap, CORS, canonical URLs)
SITE_URL=https://www.orinnovative.com

# Comma separated list of extra origins allowed to call the API (SITE_URL is always allowed)
CORS_EXTRA_ORIGINS=http://localhost:5000,http://localhost:5173

# MongoDB
MONGO_URI=mongodb+srv://adityakumarshakya92929_db_user:<NI2bVXx4CLmMSrmx>@orinnovative.xoarugp.mongodb.net/?appName=orinnovative

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=2h
JWT_COOKIE_NAME=orinnovative_token

# Default admin account (created automatically on first run if no admin exists)
# Change the password immediately after first login.
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=admin@orinnovative.com
ADMIN_PASSWORD=ChangeMe@12345

# Uploads
MAX_UPLOAD_MB=5

# Cloudinary (OPTIONAL). Leave all three blank to use local disk storage
# under backend/uploads instead. If all three are set, media uploads
# automatically switch to Cloudinary — no code changes needed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=orinnovative

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=8
